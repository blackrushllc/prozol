 $COMPILE UNIT
 $ERROR ALL ON
 $DIM ARRAY
' $DEBUG UNIT
 DECLARE SUB PROZOPRINT (byval STRING)
 DECLARE FUNCTION PROZOINPUT$ ()
 DEFINT A-Z
 EXTERNAL GoFlag%,CrLf$

 SUB ELIZA PUBLIC
   RESTORE ELIZADATA
   PROZOPRINT "^0^BELIZA" + CrLf$
   PROZOPRINT "^cAdapted for PROZOL by Erik Olson^w" + CrLf$
   PROZOPRINT "********************************" + CrLf$
   PROZOPRINT CrLf$+CrLf$
      REM*****INITIALIZATION**********
    DIM S(36), R(36), N(36)
    DIM KEYWORD$(36), WORDIN$(7), WORDOUT$(7), REPLIES$(112)
    N1 = 36: N2 = 14: N3 = 112
    FOR X = 1 TO N1: READ KEYWORD$(X): NEXT X
    FOR X = 1 TO N2 / 2: READ WORDIN$(X): READ WORDOUT$(X): NEXT X
    FOR X = 1 TO N3: READ REPLIES$(X): NEXT X
    FOR X = 1 TO N1
    READ S(X), L: R(X) = S(X): N(X) = S(X) + L - 1
    NEXT X
    PROZOPRINT "^mELIZA: HI! I'M ELIZA. WHAT'S YOUR PROBLEM?^w" + CrLf$
170 REM ***********************************
    REM *******USER INPUT SECTION**********
    REM ***********************************
    GoFlag%=0
    I$=PROZOINPUT$
'    PROZOPRINT "^0"+I$+"^B"
    IF GoFlag% THEN EXIT SUB
    U$=UCASE$(REMOVE$(I$,ANY ".,-!'"))
    I$ = "  " + I$ + "  "
    REM GET RID OF APOSTROPHES
    'FOR L = 1 TO LEN(I$)
230 REM IF MID$(I$,L,1)="'"THEN I$=LEFT$(I$,L-1)+RIGHT$(I$,LEN(I$)-L):GOTO 230
    'IF L + 4 > LEN(I$) THEN 250
    IF INSTR(I$,"SHUT") THEN PROZOPRINT "^mELIZA: O.K. IF YOU FEEL THAT WAY I'LL SHUT UP....^w"+CrLf$:EXIT SUB
    IF INSTR(I$,"BYE") OR I$="" THEN PROZOPRINT "^mELIZA: GOODBYE!^w"+CrLf$:EXIT SUB
250 'NEXT L
    IF I$ = P$ THEN PROZOPRINT "^mPLEASE DON'T REPEAT YOURSELF!^w"+CrLf$: GOTO 170
    REM ***********************************
    REM ********FIND KEYWORD IN I$*********
    REM ***********************************
    FOR K = 1 TO N1
    FOR L = 1 TO LEN(I$) - LEN(KEYWORD$(K)) + 1
    IF MID$(I$, L, LEN(KEYWORD$(K))) <> KEYWORD$(K) THEN 350
    IF K <> 13 THEN 349
    IF MID$(I$, L, LEN(KEYWORD$(29))) = KEYWORD$(29) THEN K = 29
349 F$ = KEYWORD$(K): GOTO 390
350 NEXT L
    NEXT K
    K = 36: GOTO 570: REM WE DIDN'T FIND ANY KEYWORDS
    REM ******************************************
390 REM **TAKE PART OF STRING AND CONJUGATE IT****
    REM **USING THE LIST OF STRINGS TO BE SWAPPED*
    REM ******************************************
    C$ = " " + RIGHT$(I$, LEN(I$) - LEN(F$) - L + 1) + " "
    FOR X = 1 TO N2 / 2
    FOR L = 1 TO LEN(C$)
    IF L + LEN(WORDIN$(X)) > LEN(C$) THEN 510
    IF MID$(C$, L, LEN(WORDIN$(X))) <> WORDIN$(X) THEN 510
    C$ = LEFT$(C$, L - 1) + WORDOUT$(X) + RIGHT$(C$, LEN(C$) - L - LEN(WORDIN$(X)) + 1)
    L = L + LEN(WORDOUT$(X))
    GOTO 540
510 IF L + LEN(WORDOUT$(X)) > LEN(C$) THEN 540
    IF MID$(C$, L, LEN(WORDOUT$(X))) <> WORDOUT$(X) THEN 540
    C$ = LEFT$(C$, L - 1) + WORDIN$(X) + RIGHT$(C$, LEN(C$) - L - LEN(WORDOUT$(X)) + 1)
    L = L + LEN(WORDIN$(X))
540 NEXT L
    NEXT X
    IF MID$(C$, 2, 1) = " " THEN C$ = RIGHT$(C$, LEN(C$) - 1): REM ONLY 1 SPACE
    FOR L = 1 TO LEN(C$)
557 IF MID$(C$, L, 1) = "!" THEN C$ = LEFT$(C$, L - 1) + RIGHT$(C$, LEN(C$) - L): GOTO 557
    NEXT L
    REM **********************************************
570 REM **NOW USING THE KEYWORD NUMBER (K) GET REPLY**
    REM **********************************************
    F$ = REPLIES$(R(K))
    R(K) = R(K) + 1: IF R(K) > N(K) THEN R(K) = S(K)
    IF RIGHT$(F$, 1) <> "*" THEN PROZOPRINT "^mELIZA: "+F$+"^w"+CrLf$: P$ = I$: GOTO 170
    IF C$ <> "   " THEN 630
    PROZOPRINT "^m ELIZA: YOU WILL HAVE TO ELABORATE MORE FOR ME TO HELP YOU^w"+CrLf$
    GOTO 170
630 PROZOPRINT LEFT$(F$, LEN(F$) - 1) + C$ + CrLf$
    P$ = I$: GOTO 170
     REM *******************************
