SUB EFFECT (Eff$)
SELECT CASE Eff$

	'CASE "MODEMERROR"
	'FOR y = 100 TO 50 STEP -.25: SOUND y, .1: NEXT y
	CASE "PHASERS"
        FOR y% = 500 TO 50 STEP -25: SOUND y%, .05: NEXT y%
        FOR y% = 500 TO 50 STEP -25: SOUND y%, .05: NEXT y%
        FOR y% = 500 TO 50 STEP -25: SOUND y%, .05: NEXT y%
	CASE "PAGE"
	FOR y% = 50 TO 5000 STEP 200: SOUND y%, .1: NEXT y%
	FOR y% = 50 TO 5000 STEP 200: SOUND y%, .1: NEXT y%
	FOR y% = 50 TO 5000 STEP 200: SOUND y%, .1: NEXT y%
	CASE "CRASH"
	FOR y% = 1500 TO 1000 STEP -5: SOUND y%, .2: NEXT y%
	FOR y% = 1000 TO 750 STEP -10: SOUND y%, .2: NEXT y%
	FOR y% = 750 TO 400 STEP -20: SOUND y%, .2: NEXT y%
	FOR y% = 400 TO 50 STEP -50: SOUND y%, .2: NEXT y%
	FOR y% = 1 TO 500: SOUND INT(RND(1) * 500) + 50, .05: NEXT y%
'
CASE ELSE
END SELECT
END SUB

